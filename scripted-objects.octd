","onAnimationFrame":"return this.geometry;"}},{"id":"meshcraft-scene-root","name":"Root","kind":"MESH","definitionOrigin":{"x":0.0,"y":0.0,"z":0.0},"definitionAxisU":{"x":1.0,"y":0.0,"z":0.0},"definitionAxisV":{"x":0.0,"y":1.0,"z":0.0},"definitionAxisW":{"x":0.0,"y":0.0,"z":1.0},"segments":[],"faces":[],"prototypeVertices":[],"externalReferenceEnabled":false,"externalReferencePath":"","gluedToSurface":false,"meshcraftChildren":[{"id":"meshcraft-instance-68","prototypeId":"meshcraft-prototype-67","instanceOrigin":{"x":-7.0,"y":0.0,"z":-8.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[],"meshcraftScriptState":{"initializer":"function onCreate(instance, model) {\n}","properties":{}}},{"id":"meshcraft-instance-76","prototypeId":"meshcraft-prototype-67","instanceOrigin":{"x":-4.0,"y":0.0,"z":-8.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[],"meshcraftScriptState":{"initializer":"function onCreate(instance, model) {\n}","properties":{}}},{"id":"meshcraft-instance-84","prototypeId":"meshcraft-prototype-67","instanceOrigin":{"x":-1.0,"y":0.0,"z":-8.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[],"meshcraftScriptState":{"initializer":"function onCreate(instance, model) {\n}","properties":{}}},{"id":"meshcraft-instance-92","prototypeId":"meshcraft-prototype-67","instanceOrigin":{"x":2.0,"y":0.0,"z":-8.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[],"meshcraftScriptState":{"initializer":"function onCreate(instance, model) {\n}","properties":{}}},{"id":"meshcraft-instance-100","prototypeId":"meshcraft-prototype-67","instanceOrigin":{"x":5.0,"y":0.0,"z":-8.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"ins