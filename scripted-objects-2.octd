":4.0,"z":0.4303273680015014},"c":{"x":4.0,"y":4.0,"z":0.4303273680015014},"color":{"r":1.0,"g":1.0,"b":1.0,"a":1.0},"meshcraftMaterialId":"default"},{"id":"meshcraft-face-128","a":{"x":4.0,"y":0.0,"z":0.0},"b":{"x":4.0,"y":4.0,"z":0.0},"c":{"x":4.0,"y":4.0,"z":0.4303273680015014},"color":{"r":1.0,"g":1.0,"b":1.0,"a":1.0},"meshcraftMaterialId":"default"},{"id":"meshcraft-face-129","a":{"x":4.0,"y":0.0,"z":0.0},"b":{"x":4.0,"y":4.0,"z":0.4303273680015014},"c":{"x":4.0,"y":0.0,"z":0.4303273680015014},"color":{"r":1.0,"g":1.0,"b":1.0,"a":1.0},"meshcraftMaterialId":"default"}],"externalReferenceEnabled":false,"externalReferencePath":"","gluedToSurface":false,"meshcraftScript":{"enabled":true,"source":"\nfunction onCreate(instance, model) {\n}\n\nfunction quad(a,b,id,material){\n  const x0=min(a.x,b.x)\n  const x1=max(a.x,b.x)\n  const y0=min(a.z,b.z)\n  const y1=max(a.z,b.z)\n  const p0=new Point(x0, y0, 0)\n  const p1=new Point(x1, y0, 0)\n  const p2=new Point(x1, y1, 0)\n  const p3=new Point(x0, y1, 0)\n  return [\n    face(p0,p1,p2, id + ':face1',material),\n    face(p0,p2,p3, id + ':face2',material)\n  ]\n}\n\n\nfunction onAnimationFrame(instance, model) {\n  const dt=new Date(this.time*1000)\n  const seconds=6*dt.getSeconds()\n  const minutes=6*dt.getMinutes()\n  const hours=30*(dt.getHours()%12)\n  const sec=quad(new Point(-0.05, 1, 1.9),new Point(0.05, 1, 3.9),'sec',new Material('#ff0000ff'))\n  const min=quad(new Point(-0.125, 1, 1.9),new Point(0.125, 1, 3.4),'min',new Material('#00ff00ff'))\n  const hrs=quad(new Point(-0.15, 1, 1.9),new Point(0.15, 1, 2.9),'hrs',new Material('#0000ffff'))\n  const tz=(entities,z)=>translate(new Point(0, 0, z))(entities)\n  const ty=(entities,y)=>translate(new Point(0, y, 0))(entities)\n  const center=new Point(0, 2.4, 0)\n  const dir=new Point(0, 0, 1)\n  const rotY=(ents,angle)=>rotate(center, dir, angle)(ents)\n  const markings=new Array(12).fill(1).map((v,i) => {\n    return rotY(quad(new Point(-0.05, 1, 4),new Point(0.05, 1, 4.4), instance.id +':hh:'+i+ ':edge',new Material('#000000ff')),30*i)\n  })\n  return [\n      ... quad(new Point(-2, 0, 0),new Point(2, 0, 4),'quadrant',new Material('#ffffffff')),\n      ...ty(tz(rotY(sec,seconds),-0.1),-0.4),\n      ...ty(tz(rotY(min,minutes),-0.2),-0.4),\n      ...ty(tz(rotY(hrs,hours),-0.3),-0.4),\n      ...ty(tz(markings,-0.1),-0.4),\n    ];\n}\n","onCreate":"","onAnimationFrame":"return this.geometry;"}}],"rootInstance":{"id":"meshcraft-scene-root-instance","prototypeId":"meshcraft-prototype-0","instanceOrigin":{"x":0.0,"y":0.0,"z":0.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[{"id":"meshcraft-instance-132","prototypeId":"meshcraft-prototype-131","instanceOrigin":{"x":0.0,"y":0.0,"z":2.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[],"meshcraftScriptState":{"initializer":"function onCreate(instance, model) {\n}","properties":{}}},{"id":"meshcraft-instance-96","prototypeId":"meshcraft-prototype-131","instanceOrigin":{"x":-2.0,"y":0.0,"z":4.0},"instanceAxisU":{"x":6.123233995736766e-17,"y":0.0,"z":-1.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":1.0,"y":0.0,"z":6.123233995736766e-17},"children":[],"meshcraftScriptState":{"initializer":"function onCreate(instance, model) {\n}","properties":{}}},{"id":"meshcraft-instance-97","prototypeId":"meshcraft-prototype-131","instanceOrigin":{"x":0.0,"y":0.0,"z":6.0},"instanceAxisU":{"x":-1.0,"y":0.0,"z":-1.2246467991473532e-16},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":1.2246467991473532e-16,"y":0.0,"z":-1.0},"children":[],"meshcraftScriptState":{"initializer":"function onCreate(instance, model) {\n}","properties":{}}},{"id":"meshcraft-instance-100","prototypeId":"meshcraft-prototype-131","instanceOrigin":{"x":2.0,"y":-2.537652627714643e-15,"z":4.0},"instanceAxisU":{"x":6.1232