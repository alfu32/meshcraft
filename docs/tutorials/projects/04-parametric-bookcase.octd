{"version":17,"prototypes":[{"id":"meshcraft-prototype-34","name":"Scripted Object","kind":"MESH","definitionOrigin":{"x":0.0,"y":0.0,"z":0.0},"definitionAxisU":{"x":1.0,"y":0.0,"z":0.0},"definitionAxisV":{"x":0.0,"y":1.0,"z":0.0},"definitionAxisW":{"x":0.0,"y":0.0,"z":1.0},"segments":[],"faces":[],"meshcraftScript":{"enabled":true,"apiVersion":2,"source":"// A bookcase rebuilt from its parameters on every change.\nfunction onCreate() {\n  $NUMBER('shelves', 'Shelves', 3);\n  $HOTSPOT(new Point(80, 180, 30), 'size', 'Size');\n}\n\nfunction onAnimationFrame(params) {\n  const width = Math.max(30, params.size.position.x);\n  const height = Math.max(40, params.size.position.y);\n  const depth = 30, t = 3;\n  const wood = phong('#b98751ff');\n  const box = (id, a, b) => cuboid(new Point(...a), new Point(...b), id, wood);\n  const parts = [\n    box('left', [0, 0, 0], [t, height, depth]),\n    box('right', [width - t, 0, 0], [width, height, depth]),\n    box('top', [t, height - t, 0], [width - t, height, depth]),\n    box('base', [t, 0, 0], [width - t, 30, depth]),\n  ];\n  for (let i = 1; i <= params.shelves; i++) {\n    const y = 30 + (height - 33) * i / (params.shelves + 1);\n    parts.push(box('shelf' + i, [t, y, 0], [width - t, y + 2, depth]));\n  }\n  return parts;\n}\n","onCreate":"","onAnimationFrame":"return this.geometry;"},"scriptParameterDeclarations":[{"id":"shelves","label":"Shelves","scope":"instance","kind":"number","defaultValue":3,"options":{}},{"id":"size","label":"Size","scope":"instance","kind":"hotspot","defaultValue":{"x":80,"y":180,"z":30,"id":""},"options":{},"hotspotStyle":{"shape":"CIRCLE","color":{"red":0,"green":255,"blue":255,"alpha":255}}}],"gluedToSurface":false,"externalReferenceEnabled":false,"externalReferencePath":""},{"id":"meshcraft-scene-root","name":"Root","kind":"MESH","definitionOrigin":{"x":0.0,"y":0.0,"z":0.0},"definitionAxisU":{"x":1.0,"y":0.0,"z":0.0},"definitionAxisV":{"x":0.0,"y":1.0,"z":0.0},"definitionAxisW":{"x":0.0,"y":