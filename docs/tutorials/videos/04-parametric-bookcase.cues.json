      "voice": "57323a25eeebd63b"
    },
    {
      "start": 26.863,
      "end": 36.563,
      "text": "$NUMBER adds a field to the panel. $HOTSPOT adds a handle you can drag.",
      "reading_seconds": 8.75,
      "voice": "834767a2b696e3c4"
    },
    {
      "start": 36.613,
      "end": 40.085,
      "text": "Close the editor to get back to the model.",
