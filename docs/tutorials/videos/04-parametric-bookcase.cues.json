      "voice": "e25b4ba0572bcfc9"
    },
    {
      "start": 40.135,
      "end": 45.956,
      "text": "To size it, press G for a grid helper on the face of the bookcase.",
      "reading_seconds": 5.87,
      "voice": "ca1a4100bf660b4c"
    },
    {
      "start": 46.006,
      "end": 52.226,
      "text": "Now drag the hotspot along that grid. The bookcase is rebuilt as it moves.",
