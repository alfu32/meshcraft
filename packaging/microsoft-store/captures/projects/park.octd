,"ifcProperties":{}},{"id":"meshcraft-instance-2120","prototypeId":"meshcraft-prototype-2118","instanceOrigin":{"x":-23.0,"y":0.2,"z":-9.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[]},{"id":"meshcraft-instance-2123","prototypeId":"meshcraft-prototype-2121","instanceOrigin":{"x":39.0,"y":0.2,"z":-14.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[]},{"id":"meshcraft-instance-2126","prototypeId":"meshcraft-prototype-2124","instanceOrigin":{"x":64.0,"y":0.2,"z":46.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[]},{"id":"meshcraft-instance-2129","prototypeId":"meshcraft-prototype-2127","instanceOrigin":{"x":-27.0,"y":0.2,"z":46.0},"instanceAxisU":{"x":1.0,"y":0.0,"z":0.0},"instanceAxisV":{"x":0.0,"y":1.0,"z":0.0},"instanceAxisW":{"x":0.0,"y":0.0,"z":1.0},"children":[]}]},"modelUnit":{"name":"cm","size":10.0},"gridSpacing":0.5,"circleSegments":24,"snapEpsilon":12.0,"cameraState":{"position":{"x":151.0,"y":105.0,"z":174.00000000000003},"direction":{"x":-0.578079915757504,"y":-0.36129994734843995,"z":-0.731632393380591},"up":{"x":-0.22399090753614312,"y":0.9324496490674522,"z":-0.28348849235043116},"target":{"x":23.0,"y":25.0,"z":12.0},"near":0.05,"far":5000.0,"fieldOfView":40.0},"meshcraftMaterials":[{"id":"ansi-black","name":"ansi-black","color":{"red":0,"green":0,"blue":0,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"ansi-red","name":"ansi-red","color":{"red":128,"green":0,"blue":0,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"ansi-green","name":"ansi-green","color":{"red":0,"green":128,"blue":0,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScale