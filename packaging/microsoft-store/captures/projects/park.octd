90,"blue":198,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"screen","name":"Instrument display","color":{"red":23,"green":46,"blue":60,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"rubber","name":"Black rubber","color":{"red":34,"green":40,"blue":44,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"pcb","name":"Circuit laminate","color":{"red":59,"green":115,"blue":91,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"oak","name":"Quarter-sawn oak","color":{"red":182,"green":141,"blue":94,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"stone","name":"Warm limestone","color":{"red":200,"green":196,"blue":183,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"concrete","name":"Architectural concrete","color":{"red":169,"green":174,"blue":173,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"linen","name":"Warm linen","color":{"red":210,"green":202,"blue":188,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"sage","name":"Sage lacquer","color":{"red":127,"green":149,"blue":132,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"brass","name":"Satin brass","color":{"red":180,"green":155,"blue":97,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"clay","name":"Terracotta","color":{"red":183,"green":109,"blue":81,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0},{"id":"park-grass","name":"Park meadow","color":{"red":69,"green":108,"blue":47,"alpha":255},"shadingType":"phong","texturePath":null,"textureScaleU":1.0,"textureScaleV":1.0,"procedural":{"program":"meshcraft.grass.v1","parameters":{"density":0.35,"height":0.7,"width":0.07,"wind":0},"baseMaterial":null,"lodDistance":250.0,"maxInstances":20000,"showBounds":false}}],"meshcraftPaletteVersion":1,"meshcraftProceduralPrograms":[{"id":"project.canopy.v1","name":"Landscape canopy","generation":"branching","backend":"vertex_instancing_gl33","parameters":[{"id":"form","kind":"enum","default":"broadleaf","label":"Form","description":"Rule family for the GPU generator.","unit":"","min":null,"max":null,"step":null,"options":{"broadleaf":"Broadleaf tree","conifer":"Conifer","coral":"Coral","roots":"Roots","shrub":"Shrub","weeping":"Weeping tree"}},{"id":"height","kind":"float","default":60,"label":"Height","description":"Tree height in local model units.","unit":"","min":0.1,"max":1000.0,"step":null,"options":{}},{"id":"radius","kind":"float","default":19,"label":"Crown radius","description":"Maximum crown radius.","unit":"","min":0.01,"max":1000.0,"step":null,"options":{}},{"id":"trunkRadius","kind":"float","default":1.5,"label":"Trunk radius","description":"Trunk base radius.","unit":"","min":0.001,"max":100.0,"step":null,"options":{}},{"id":"branches","kind":"integer","default":6,"label":"Primary branches","description":"Rendering detail; bounded by the instance budget.","unit":"","min":1.0,"max":12.0,"step":null,"options":{}},{"id":"forks","kind":"integer","default":3,"label":"Children per branch","description":"Rendering detail; bounded by the instance budget.","unit":"","min":1.0,"max":8.0,"step":null,"options":{}},{"id":"levels","kind":"integer","default":3,"label":"Branching depth","description":"Rendering detail; bounded by the instance budget.","unit":"","min":0.0,"max":6.0,"step":null,"options":{}},{"id":"leaves","kind":"integer","default":2200,"label":"Leaf budget","description":"Rendering detail; bounded by the instance budget.","unit":"","min":0.0,"max":100000.0,"step":null,"options":{}},{"id":"leafSize","kind":"float","default":2.4,"label":"Leaf size","description":"Leaf card length in local units.","unit":"","min":0.001,"max":10.0,"step":null,"options":{}},{"id":"wind","kind":"float","default":0,"label":"Wind strength","description":"Maximum sway as a fraction of height; zero pauses animation.","unit":"","min":0.0,"max":1.0,"step":null,"options":{}},{"id":"growth","kind":"float","default":1.0,"label":"Growth","description":"Continuous growth from an empty object to the configured branching depth.","unit":"","min":0.0,"max":1.0,"step":null,"options":{}},{"id":"branchDensity","kind":"float","default":1.0,"label":"Branch survival","description":"Continuous seeded pruning; zero retains only the trunk. Descendants inherit parent survival.","unit":"","min":0.0,"max":1.0,"step":null,"options":{}},{"id":"angle","kind":"float","default":42.0,"label":"Branch angle","description":"Angle from the parent's tangent, in degrees.","unit":"","min":0.0,"max":160.0,"step":null,"options":{}},{"id":"twist","kind":"float","default":137.5,"label":"Phyllotactic angle","description":"Rotation between child slots, in degrees. Slot identity stays stable when counts change.","unit":"","min":-180.0,"max":180.0,"step":null,"options":{}},{"id":"attachment","kind":"float","default":0.72,"label":"Attachment","description":"Attachment position along the parent curve; primary branches are distributed along the trunk.","unit":"","min":0.05,"max":1.0,"step":null,"options":{}},{"id":"lengthRatio","kind":"float","default":0.62,"label":"Length ratio","description":"Child length relative to its parent, before family and random variation.","unit":"","min":0.05,"max":0.9,"step":null,"options":{}},{"id":"radiusRatio","kind":"float","default":0.58,"label":"Radius ratio","description":"Child radius relative to the parent radius at its attachment.","unit":"","min":0.05,"max":0.9,"step":null,"options":{}},{"id":"bend","kind":"float","default":0.2,"label":"Curvature","description":"Quadratic branch curvature; child frames follow the curved parent tangent.","unit":"","min":-1.0,"max":1.0,"step":null,"options":{}},{"id":"gravity","kind":"float","default":0.15,"label":"Tropism","description":"Positive bends toward local up; negative bends down. Roots invert their local up.","unit":"","min":-1.0,"max":1.0,"step":null,"options":{}},{"id":"variation","kind":"float","default":0.3,"label":"Variation","description":"Deterministic variation of lengths, angles and attachments.","unit":"","min":0.0,"max":1.0,"step":null,"options":{}},{"id":"minPixels","kind":"float","default":0.25,"label":"Branch LOD","description":"Fade subpixel branch hierarchies in the viewport. Zero disables branch LOD; bake captures full detail.","unit":"","min":0.0,"max":8.0,"step":null,"options":{}},{"id":"barkColor","kind":"color","default":[0.27,0.2,0.14,1],"label":"Bark","description":"RGBA channels in the range zero to one.","unit":"","min":0.0,"max":1.0,"step":null,"options":{}},{"id":"leafColor","kind":"color","default":[0.22,0.38,0.11,1],"label":"Leaves","description":"RGBA channels in the range zero to one.","unit":"","min":0.0,"max":1.0,"step":null,"options":{}},{"id":"seed","kind":"seed","default":1,"label":"Seed","description":"Deterministic variation. Changing this reshuffles the result.","unit":"","min":null,"max":null,"step":null,"options":{}}],"vertex":"// A landscape canopy built from the GPU's seeded branch hierarchy.\n// Each child inherits its parent's curved frame; no mesh is generated on CPU.\nvoid branchingRule(inout BranchRule rule, int level, int child,\n                   uvec2 path, uint key) {\n    float variation = random(key);\n    if (level == 1) {\n        rule.lengthScale *= mix(0.82, 1.06, variation);\n        rule.angle += 0.12 * sin(float(child) * 2.39996);\n    }\n    if (level > 2) rule.tropism += 0.12;\n}\nvoid proceduralVertex(inout vec3 position, inout vec3 normal, vec2 uv) {\n}\n","fragment":"vec4 proceduralColor(vec4 c,vec3 p,vec3 n,vec2 uv) {\n    if(treePart>0.5) {\n        vec2 q=vec2((uv.x-0.5)*2.0,uv.y*2.0-1.0);\n        if(dot(q,q)>1.0)discard;\n        float vein=1.0-0.15*exp(-abs(q.x)*35.0);\n        return vec4(u_leafColor.rgb*vein*(0.75+0.25*fract(sin(treeKey*73.1)*43758.5)),u_leafColor.a);\n    }\n    float grooves=0.75+0.25*sin(uv.x*68.0+sin(uv.y*12.0)*2.0);\n    return vec4(u_barkColor.rgb*grooves,u_barkColor.a);\n}\n","boundsExpansion":0.0,"animated":true,"transparent":false,"branchingLimits":{"maxDepth":6,"maxPrimaryBranches":12,"maxChildren":8,"maxBranchCandidates":16384,"curveSegments":3,"radialSectors":6,"hook":"branchingRule(inout BranchRule rule,int level,int child,uvec2 path,uint key)","ruleType":"struct BranchRule { float attach; float angle; float azimuth; float lengthScale; float radiusScale; float bend; float tropism; float activation; vec3 parentStart; vec3 parentControl; vec3 parentEnd; vec3 parentFrame; float parentRadius; };","pathEncoding":"root=1; append four-bit child+1 slots; x=low32, y=high32","ruleFields":{"attach":"Parent curve parameter, clamped 0..1","angle":"Deflection from parent tangent in radians, clamped 0..pi","azimuth":"Rotation around parent tangent in radians","lengthScale":"Child/parent chord length ratio, clamped 0..2.5","radiusScale":"Child/parent attachment radius ratio, clamped 0..0.95","bend":"Quadratic curvature, clamped -1..1","tropism":"Local vertical attraction, clamped -1..1","activation":"Continuous child survival, clamped 0..1; inherited by descendants","parentStart":"vec3; read-only local parent curve start; writes ignored","parentControl":"vec3; read-only local quadratic control point; writes ignored","parentEnd":"vec3; read-only local parent curve end; writes ignored","parentFrame":"vec3; read-only transported frame reference; writes ignored","parentRadius":"float; read-only parent base radius; writes ignored"}}}],"undoHistory":{"maxEntries":21,"index":20,"entries":[{"data":"","label":"Initial","timestamp":0},{"data":"","label":"Create architecture element","timestamp":1793408574487},{"data":"","label":"Create architecture element","timestamp":1793408574728},{"data":"","label":"Create architecture element","timestamp":1793408574962},{"data":"","label":"Create architecture element","timestamp":1793408575231},{"data":"","label":"Create architecture element","timestamp":1793408575572},{"data":"","label":"One-shot script","timestamp":1793408576169},{"data":"","label":"One-shot script","timestamp":1793408576781},{"data":"","label":"One-shot script","timestamp":1793408577402},{"data":"","label":"One-shot script","timestamp":1793408577965},{"data":"","label":"One-shot script","timestamp":1793408578506},{"data":"","label":"One-shot script","timestamp":1793408579067},{"data":"","label":"One-shot script","timestamp":1793408579696},{"data":"","label":"Configure procedural object","timestamp":1793408580156},{"data":"","label":"Place object instance","timestamp":1793408580633},{"data":"","label":"Configure procedural object","timestamp":1793408581707},{"data":"","label":"Place object instance","timestamp":1793408582052},{"data":"","label":"Configure procedural object","timestamp":1793408582870},{"data":"","label":"Place object instance","timestamp":1793408583191},{"data":"","label":"Configure procedural object","timestamp":1793408584148},{"data":"","label":"Place object instance","timestamp":1793408584517}]}}