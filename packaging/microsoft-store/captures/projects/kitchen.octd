,"name":"C-series | configurable casework","kind":"MESH","definitionOrigin":{"x":0.0,"y":0.0,"z":0.0},"definitionAxisU":{"x":1.0,"y":0.0,"z":0.0},"definitionAxisV":{"x":0.0,"y":1.0,"z":0.0},"definitionAxisW":{"x":0.0,"y":0.0,"z":1.0},"segments":[],"faces":[],"externalReferenceEnabled":false,"externalReferencePath":"","gluedToSurface":false,"meshcraftScript":{"enabled":true,"apiVersion":2,"source":"// One shared construction rule; each placed cabinet keeps independent dimensions.\n$NUMBER('plate', 'Plate thickness', 0.2);\nfunction onCreate() {\n  $NUMBER('width', 'Width', 6);\n  $NUMBER('height', 'Height', 8.8);\n  $NUMBER('depth', 'Depth', 5.6);\n  $NUMBER('opening', 'Opening angle', 0);\n  $NUMBER('shelves', 'Shelves', 1);\n  $CHECKBOX('feet', 'Adjustable feet', true);\n  $CHECKBOX('top', 'Top panel', true);\n  $LIST('layout', {doors:'Hinged doors',drawers:'Drawer stack',open:'Open shelving'}, 'Front', 'doors');\n  $MATERIAL('front', 'Front finish', 'sage');\n  $MATERIAL('carcass', 'Carcass finish', 'ivory');\n  $HOTSPOT(new Point(6,8.8,5.6), 'size', 'Size', $HOTSPOT_SHAPE_DIAMOND, '#18c7e6ff');\n}\nfunction onAnimationFrame(params) {\n  const {plate:T,opening,layout,front,carcass,shelves,feet}=params;\n  const W=Math.max(2,params.width+params.size.position.x-6);\n  const H=Math.max(2,params.height+params.size.position.y-8.8);\n  const D=Math.max(2,params.depth+params.size.position.z-5.6);\n  const base=feet?1:0;\n  B(0,base,0,T,H-base,D,carcass);B(W-T,base,0,T,H-base,D,carcass);\n  B(T,base,0,W-2*T,T,D,carcass);if(params.top)B(T,H-T,0,W-2*T,T,D,carcass);\n  B(T,base+T,0,W-2*T,H-base-2*T,T*.45,carcass);\n  if(feet)for(const x of [.4,W-.4])for(const z of [.5,D-.5]){\n    B(x-.1,0,z-.1,.2,base,.2,'graphite');B(x-.2,0,z-.2,.4,.08,.4,'graphite');\n  }\n  if(layout==='drawers'){\n    for(let i=0;i<3;i++){\n      const y=base+(H-base)*i/3+.04,h=(H-base)/3-.08,z=D+.06+(i===2?opening*.035:0);\n      B(.04,y,z,W-.08,h,T,front);\n      B(.35,y+.15,z-D+.6,W-.7,T,D-.8,carcass);\n      B(.3,y+.15,z-D+.6,T,h-.3,D-.8,carcass);B(W-.3-T,y+.15,z-D+.6,T,h-.3,D-.8,carcass);\n      B(.35,y+.15,z-D+.6,W-.7,h-.3,T,carcass);\n      B(W*.26,y+h-.35,z+T+.12,W*.48,.08,.13,'brass');\n    }\n  }else{\n    for(let s=1;s<=Math.min(5,shelves);s++)B(T,base+(H-base)*s/(shelves+1),T,W-2*T,T,D-T-.1,carcass);\n    if(layout==='doors')for(let side=0;side<2;side++){\n      const start=out.length,x=side*W/2+.03;\n      B(x,base+.025,D+.06,W/2-.06,H-base-.05,T,front);\n      B(side?W/2+.22:W/2-.31,H-1.05,D+T+.15,.09,.75,.13,'brass');\n      const door=out.splice(start);\n      out.push(rotate(P(side?W:0,0,D+.06),P(0,1,0),side?opening:-opening,door));\n    }\n  }\n  return [this.geometry,out];\n}\n\n// Shared modeling helpers, evaluated inside Meshcraft's documented one-shot SDK.\n// Every result becomes editable native mesh geometry, not an external render.\nconst P=(x=0,y=0,z=0)=>new Point(x,y,z), out=[];\nlet serial=0;\nconst ID=k=>k+':'+serial++;\nconst materials={};\nfunction M(key){\n  if(typeof key==='object')return key;\n  if(key.startsWith('#'))return phong(key);\n  return materials[key]||(materials[key]=model.getMaterial(key));\n}\nconst va=(a,b)=>a.map((v,i)=>v+b[i]),vs=(a,b)=>a.map((v,i)=>v-b[i]);\nconst vm=(a,s)=>a.map(v=>v*s),vd=(a,b)=>a.reduce((s,v,i)=>s+v*b[i],0);\nconst vc=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];\nconst vn=a=>vm(a,1/Math.hypot(...a));\nfunction B(x,y,z,w,h,d,mat='ivory'){\n  out.push(cuboid(P(x,y,z),P(x+w,y+h,z+d),ID('panel'),M(mat)));\n}\nfunction Q(a,b,c,d,mat){out.push(face(P(...a),P(...b),P(...c),ID('face'),M(mat)),face(P(...a),P(...c),P(...d),ID('face'),M(mat)));}\nfunction E(a,b,mat='graphite'){out.push(line(P(...a),P(...b),ID('edge'),M(mat)));}\nfunction basis(a,b){const t=vn(vs(b,a)),u=vn(vc(t,Math.abs(t[1])<.8?[0,1,0]:[1,0,0]));return [u,vc(t,u)];}\nfunction round(a,r,u,v,i,n){const t=i*2*Math.PI/n;return va(a,va(vm(u,r*Math.cos(t)),vm(v,r*Math.sin(t))));}\nfunction R(a,b,r,mat='steel',n=20){\n 