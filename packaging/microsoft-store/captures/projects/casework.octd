{"version":17,"prototypes":[{"id":"meshcraft-prototype-34","name":"Atelier | configurable storage","kind":"MESH","definitionOrigin":{"x":0.0,"y":0.0,"z":0.0},"definitionAxisU":{"x":1.0,"y":0.0,"z":0.0},"definitionAxisV":{"x":0.0,"y":1.0,"z":0.0},"definitionAxisW":{"x":0.0,"y":0.0,"z":1.0},"segments":[],"faces":[],"externalReferenceEnabled":false,"externalReferencePath":"","gluedToSurface":false,"meshcraftScript":{"enabled":true,"apiVersion":2,"source":"// One shared construction rule; each placed cabinet keeps independent dimensions.\n$NUMBER('plate', 'Plate thickness', 0.2);\nconst BASE = {width:18,height:12,depth:4.5};\nfunction onCreate() {\n  $NUMBER('width', 'Width', BASE.width);\n  $NUMBER('height', 'Height', BASE.height);\n  $NUMBER('depth', 'Depth', BASE.depth);\n  $NUMBER('opening', 'Opening angle', 0);\n  $NUMBER('shelves', 'Shelves', 1);\n  $CHECKBOX('feet', 'Adjustable feet', true);\n  $CHECKBOX('top', 'Top panel', true);\n  $CHECKBOX('display', 'Shelf contents', true);\n  $LIST('layout', {doors:'Hinged doors',drawers:'Drawer stack',open:'Open shelving'}, 'Front', 'open');\n  $MATERIAL('front', 'Front finish', 'sage');\n  $MATERIAL('carcass', 'Carcass finish', 'ivory');\n  $HOTSPOT(new Point(BASE.width,BASE.height,BASE.depth), 'size', 'Size', $HOTSPOT_SHAPE_DIAMOND, '#18c7e6ff');\n}\nfunction onAnimationFrame(params) {\n  const {plate:T,opening,layout,front,carcass,shelves,feet}=params;\n  const W=Math.max(2,params.width+params.size.position.x-BASE.width);\n  const H=Math.max(2,params.height+params.size.position.y-BASE.height);\n  const D=Math.max(2,params.depth+params.size.position.z-BASE.depth);\n  const base=feet?1:0;\n  B(0,base,0,T,H-base,D,carcass);B(W-T,base,0,T,H-base,D,carcass);\n  B(T,base,0,W-2*T,T,D,carcass);if(params.top)B(T,H-T,0,W-2*T,T,D,carcass);\n  B(T,base+T,0,W-2*T,H-base-2*T,T*.45,carcass);\n  if(feet)for(const x of [.4,W-.4])for(const z of [.5,D-.5]){\n    B(x-.1,0,z-.1,.2,base,.2,'graphite');B(x-.2,0,z-.2,.4,.08,.4,'graphite');\n  }\n  if(layout==='drawers'){\n    for(let i=0;i<3;i++){\n      const y=base+(H-base)*i/3+.04,h=(H-base)/3-.08,z=D+.06+(i===2?opening*.035:0);\n      B(.04,y,z,W-.08,h,T,front);\n      B(.35,y+.15,z-D+.6,W-.7,T,D-.8,carcass);\n      B(.3,y+.15,z-D+.6,T,h-.3,D-.8,carcass);B(W-.3-T,y+.15,z-D+.6,T,h-.3,D-.8,carcass);\n      B(.35,y+.15,z-D+.6,W-.7,h-.3,T,carcass);\n      B(W*.26,y+h-.35,z+T+.12,W*.48,.08,.13,'brass');\n    }\n  }else{\n    for(let s=1;s<=Math.min(5,shelves);s++)B(T,base+(H-base)*s/(shelves+1),T,W-2*T,T,D-T-.1,carcass);\n    if(layout==='doors')for(let side=0;side<2;side++){\n      const start=out.length,x=side*W/2+.03;\n      B(x,base+.025,D+.06,W/2-.06,H-base-.05,T,front);\n      B(side?W/2+.22:W/2-.31,H-1.05,D+T+.15,.09,.75,.13,'brass');\n      const door=out.splice(start);\n      out.push(rotate(P(side?W:0,0,D+.06),P(0,1,0),side?opening:-opening,door));\n    }\n  }\n  if(params.display && layout==='open'){\n    for(const x of [W/3,2*W/3])B(x,base+T,T,T,H-base-2*T,D-T,carcass);\n    const y=base+T;\n    for(let i=0;i<7;i++)B(T+.2+i*.55,y,D-2.6,.36,2.1+(i%3)*.25,2.2,['ivory','sage','clay'][i%3]);\n    B(W/3+.45,y,T+.5,W/3-1.2,2.5,D-T-.9,'linen');B(W/2-.6,y+1.1,D-.35,1.2,.4,.04,'graphite');\n    B(2*W/3+.4,base+(H-base)*.52,T+.3,W/3-1,1.6,D-.7,'sage');\n    B(T+.4,base+(H-base)*.72,D-2.4,W/3-.8,.3,2.1,'ivory');\n    B(T+.7,base+(H-base)*.72+.3,D-2.2,W/3-1.1,.22,1.9,'clay');\n  }\n  return [this.geometry,out];\n}\n\n// Shared modeling helpers, evaluated inside Meshcraft's documented one-shot SDK.\n// Every result becomes editable native mesh geometry, not an external render.\nconst P=(x=0,y=0,z=0)=>new Point(x,y,z), out=[];\nlet serial=0;\nconst ID=k=>k+':'+serial++;\nconst materials={};\nfunction M(key){\n  if(typeof key==='object')return key;\n  if(key.startsWith('#'))return phong(key);\n  return materials[key]||(materials[key]=model.getMaterial(key));\n}\nconst va=(a,b)=>a.map((v,i)=>v+b[i]),vs=(a,b)=>a.map((v,i)=>v-b[i]);\nconst vm=(a,s)=>a.map(v=>v*s),vd=(a,b)=>a.reduce((s,v,i)=>s+v*b[i],0);\nconst vc=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];\nconst vn=a=>vm(a,1/Math.hypot(...a));\nfunction B(x,y,z,w,h,d,mat='ivory'){\n  out.push(cuboid(P(x,y,z),P(x+w,y+h,z+d),ID('panel'),M(mat)));\n}\nfunction Q(a,b,c,d,mat){out.push(face(P(...a),P(...b),P(...c),ID('face'),M(mat)),face(P(...a),P(...c),P(...d),ID('face'),M(mat)));}\nfunction E(a,b,mat='graphite'){out.push(line(P(...a),P(...b),ID('edge'),M(mat)));}\nfunction basis(a,b){const t=vn(vs(b,a)),u=vn(vc(t,Math.abs(t[1])<.8?[0,1,0]:[1,0,0]));return [u,vc(t,u)];}\nfunction round(a,r,u,v,i,n){const t=i*2*Math.PI/n;return va(a,va(vm(u,r*Math.cos(t)),vm(v,r*Math.sin(t))));}\nfunction R(a,b,r,mat='steel',n=20){\n  const [u,v]=basis(a,b);\n  for(let i=0;i<n;i++){\n    const a0=round(a,r,u,v,i,n),a1=round(a,r,u,v,i+1,n),b0=round(b,r,u,v,i,n),b1=round(b,r,u,v,i+1,n);\n    Q(a0,a1,b1,b0,mat);\n    out.push(face(P(...a),P(...a1),P(...a0),ID('cap'),M(mat)),face(P(...b),P(...b0),P(...b1),ID('cap'),M(mat)));\n    E(a0,a1,mat);E(b0,b1,mat);\n  }\n}\nfunction Ring(a,b,ro,ri,mat='steel',n=24){\n  const [u,v]=basis(a,b);\n  for(let i=0;i<n;i++){\n    const a0=round(a,ro,u,v,i,n),a1=round(a,ro,u,v,i+1,n),b0=round(b,ro,u,v,i,n),b1=round(b,ro,u,v,i+1,n);\n    const c0=round(a,ri,u,v,i,n),c1=round(a,ri,u,v,i+1,n),d0=round(b,ri,u,v,i,n),d1=round(b,ri,u,v,i+1,n);\n    Q(a0,a1,b1,b0,mat);Q(c1,c0,d0,d1,mat);Q(a1,a0,c0,c1,mat);Q(b0,b1,d1,d0,mat);\n    E(a0,a1,mat);E(b0,b1,mat);E(c0,c1,mat);E(d0,d1,mat);\n  }\n}\nfunction Pipe(points,r,mat='steel',n=16){\n  const rings=points.map((p,i)=>{\n    const [u,v]=basis(i?points[i-1]:p,i===points.length-1?p:points[i+1]);\n    return Array.from({length:n},(_,j)=>round(p,r,u,v,j,n));\n  });\n  for(let k=0;k<rings.length-1;k++)for(let i=0;i<n;i++)Q(rings[k][i],rings[k][(i+1)%n],rings[k+1][(i+1)%n],rings[k+1][i],mat);\n  for(const k of [0,rings.length-1])for(let i=0;i<n;i++)E(rings[k][i],rings[k][(i+1)%n],mat);\n}\nfunction Ball(c,r,mat='steel',n=16){out.push(sphere(P(...c),r,ID('sphere'),M(mat),n));}\nfunction Bolt(a,b,r=1.5,mat='steel'){R(a,b,r,mat,6);const d=vm(vn(vs(b,a)),r*.4);R(b,va(b,d),r*1.5,mat,6);}\nfunction Rim(x,y,z,w,h,d,t,mat='graphite'){\n  B(x,y,z,t,h,d,mat);B(x+w-t,y,z,t,h,d,mat);B(x+t,y,z,w-2*t,t,d,mat);B(x+t,y+h-t,z,w-2*t,t,d,mat);\n}\nfunction Slats(x,y,z,w,h,d,count,mat='oak'){\n  const gap=w/count;for(let i=0;i<count;i++)B(x+i*gap,y,z,gap*.42,h,d,mat);\n}\nfunction Foot(x,y,z,h,mat='graphite'){R([x,y,z],[x,y+h,z],.18,mat,12);R([x,y,z],[x,y+.06,z],.32,mat,16);}\n","onCreate":"","onAnimationFrame":"return this.geometry;"},"scriptParameterDeclarations":[{"id":"plate","label":"Plate thickness","scope":"prototype","kind":"number","defaultValue":0.2,"options":{}},{"id":"width","label":"Width","scope":"instance","kind":"number","defaultValue":18,"options":{}},{"id":"height","label":"Height","scope":"instance","kind":"number","defaultValue":12,"options":{}},{"id":"depth","label":"Depth","scope":"instance","kind":"number","defaultValue":4.5,"options":{}},{"id":"opening","label":"Opening angle","scope":"instance","kind":"number","defaultValue":0,"options":{}},{"id":"shelves","label":"Shelves","scope":"instance","kind":"number","defaultValue":1,"options":{}},{"id":"feet","label":"Adjustable feet","scope":"instance","kind":"checkbox","defaultValue":true,"options":{}},{"id":"top","label":"Top panel","scope":"instance","kind":"checkbox","defaultValue":true,"options":{}},{"id":"display","label":"Shelf contents","scope":"instance","kind":"checkbox","defaultValue":true,"options":{}},{"id":"layout","label":"Front","scope":"instance","kind":"list","defaultValue":"open","options":{"doors":"Hinged doors","drawers":"Drawer stack","open":"Open shelving"}},{"id":"front","label":"Front finish","scope":"instance","kind":"material","defaultValue":"sage","options":{}},{"id":"carcass","label":"Carcass finish","scope":"instance","kind":"material","defaultValue":"ivory","options":{}},{"id":"size","label":"Size","scope":"instance","kind":"hotspot","defaultValue":{"x":18,"y":12,"z":4.5,"id":""},"options":{},"hotspotStyle":{"shape":"DIAMOND","color":{"red":24,"green":199,"blue":230,"alpha":255}}}],"scriptParameterValues":{"plate":0.2}},{"id":"meshcraft-prototype-40","name":"Atelier | presentation floor and wall","kind":"MESH","definitionOrigin":{"x":0.0,"y":0.0,"z":0.0},"definitionAxisU":{"x":1.0,"y":0.0,"z":0.0},"definitionAxisV":{"x":0.0,"y":1.0,"z":0.0},"definitionAxisW":{"x":0.0,"y":0.0,"z":1.0},"segments":[{"id":"meshcraft-segment-27","start":{"x":-4.0,"y":24.0,"z":-1.75},"end":{"x":51.0,"y":24.0,"z":-1.75},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:1:e6:7"},{"id":"meshcraft-segment-28","start":{"x":51.0,"y":-0.25,"z":-2.0},"end":{"x":51.0,"y":-0.25,"z":18.0},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:0:e1:5"},{"id":"meshcraft-segment-29","start":{"x":51.0,"y":-0.25,"z":-2.0},"end":{"x":51.0,"y":0.0,"z":-2.0},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:0:e1:3"},{"id":"meshcraft-segment-30","start":{"x":-4.0,"y":-0.25,"z":-2.0},"end":{"x":51.0,"y":-0.25,"z":-2.0},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:0:e0:1"},{"id":"meshcraft-segment-31","start":{"x":-4.0,"y":-0.25,"z":-2.0},"end":{"x":-4.0,"y":0.0,"z":-2.0},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:0:e0:2"},{"id":"meshcraft-segment-32","start":{"x":-4.0,"y":-0.25,"z":-2.0},"end":{"x":-4.0,"y":-0.25,"z":18.0},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:0:e0:4"},{"id":"meshcraft-segment-33","start":{"x":-4.0,"y":0.0,"z":-2.0},"end":{"x":-4.0,"y":24.0,"z":-2.0},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:1:e0:2"},{"id":"meshcraft-segment-34","start":{"x":-4.0,"y":0.0,"z":-2.0},"end":{"x":51.0,"y":0.0,"z":-2.0},"meshcraftMaterialId":"ansi-black","meshcraftScriptId":"panel:1:e0:1"},{"id":"meshcraft-segment-35","start":{"x":-4.0,"y":0.0,"z":-2.0},"end":{"x":-4.0,"y":0.0,"z":-1.75},